{
  "name": "my-llm",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "infer": "tsx scripts/cli-inference.ts",
    "analyze": "tsx scripts/analyze-images.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "check": "npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~55.0.8",
    "expo-build-properties": "~55.0.10",
    "expo-dev-client": "~55.0.18",
    "expo-device": "~55.0.13",
    "expo-file-system": "~55.0.11",
    "expo-image-picker": "~55.0.13",
    "expo-location": "~55.1.7",
    "expo-media-library": "~55.0.13",
    "expo-notifications": "~55.0.17",
    "expo-sqlite": "~55.0.14",
    "expo-status-bar": "~55.0.4",
    "llama.rn": "^0.12.0-rc.6",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|llama\\.rn)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "private": true
}
